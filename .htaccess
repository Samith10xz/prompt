# Pages are checked on every visit so new versions show at once.
# CSS/JS links carry ?v=<version>; bump it in every .html on each release.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
<FilesMatch "^\.env|\.md$">
  Require all denied
</FilesMatch>
